generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Campaign {
  id         String     @id @default(cuid())
  name       String
  status     String     @default("ACTIVE")
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  user_id    String
  users      users      @relation(fields: [user_id], references: [id])
  prospects  Prospect[]

  @@index([user_id, created_at])
  @@map("campaigns")
}

/// A prospect is a person being outreached.
/// One prospect has at most one active outreach sequence.
model Prospect {
  id                    String                @id @default(cuid())
  name                  String
  company               String
  email                 String
  timezone              String
  notes                 String?
  status                ProspectStatus        @default(ACTIVE)
  created_at            DateTime              @default(now())
  user_id               String
  campaign_id           String?
  source                ProspectSource        @default(MANUAL)
  adhoc_emails          AdhocEmail[]
  campaign              Campaign?             @relation(fields: [campaign_id], references: [id])
  users                 users                 @relation(fields: [user_id], references: [id])
  reply_classifications ReplyClassification[]
  sequences             Sequence[]

  @@unique([user_id, email])
  @@index([created_at])
  @@index([status])
  @@index([user_id, created_at])
  @@map("prospects")
}

/// A sequence belongs to exactly one prospect.
/// A prospect can have at most one sequence (enforced by @unique on prospect_id).
model Sequence {
  id          String         @id @default(cuid())
  prospect_id String
  status      SequenceStatus @default(DRAFT)
  started_at  DateTime?
  stopped_at  DateTime?
  created_at  DateTime       @default(now())
  user_id     String
  steps       SequenceStep[]
  prospect    Prospect       @relation(fields: [prospect_id], references: [id], onDelete: Cascade)
  users       users          @relation(fields: [user_id], references: [id])

  @@index([prospect_id, status])
  @@index([created_at])
  @@index([status])
  @@index([user_id, created_at])
  @@index([user_id, status, created_at])
  @@index([user_id, status])
  @@map("sequences")
}

/// One step in an outreach sequence (Email 1, Follow-up #1, #2, #3).
/// Timezone fields allow the scheduler to correctly fire at the right time
/// and allow the UI to display what the user originally intended.
model SequenceStep {
  id                   String       @id @default(cuid())
  sequence_id          String
  step_number          Int
  subject              String
  body                 String
  scheduled_at_utc     DateTime
  scheduled_time_local String
  timezone             String
  status               StepStatus   @default(PENDING)
  sent_at              DateTime?
  gmail_message_id     String?
  gmail_thread_id      String?
  retry_count          Int          @default(0)
  last_retry_at        DateTime?
  delay_reason         String?
  retry_at             DateTime?
  email_events         EmailEvent[]
  sequence             Sequence     @relation(fields: [sequence_id], references: [id], onDelete: Cascade)

  @@unique([sequence_id, step_number])
  @@index([gmail_thread_id])
  @@index([status, scheduled_at_utc])
  @@index([status, retry_count])
  @@map("sequence_steps")
}

/// Immutable audit log.
/// Every send attempt, failure, skip, or cancellation creates one record here.
/// Records must never be deleted or mutated — they are the source of truth for
/// what happened and when.
model EmailEvent {
  id               String         @id @default(cuid())
  sequence_step_id String
  event_type       EmailEventType
  occurred_at      DateTime       @default(now())
  metadata         Json?
  step             SequenceStep   @relation(fields: [sequence_step_id], references: [id], onDelete: Cascade)

  @@index([occurred_at])
  @@index([event_type, occurred_at])
  @@map("email_events")
}

/// A classified reply from a Gmail thread.
/// One record per Gmail message — enforced by @unique on gmail_message_id.
/// When reply_type = REAL_REPLY, the sequence stop logic fires.
model ReplyClassification {
  id                 String       @id @default(cuid())
  prospect_id        String
  gmail_thread_id    String
  gmail_message_id   String       @unique
  reply_type         ReplyType
  raw_snippet        String?
  classified_at      DateTime     @default(now())
  confidence         Float?
  reason             String?
  recommended_action String?
  signals            Json?
  review_status      ReviewStatus @default(PENDING)
  reviewed_at        DateTime?
  prospect           Prospect     @relation(fields: [prospect_id], references: [id], onDelete: Cascade)

  @@index([gmail_thread_id])
  @@index([reply_type, review_status])
  @@index([reply_type, classified_at])
  @@map("reply_classifications")
}

/// Enterprise Error Intelligence
/// Tracks and explains technical errors in human-readable format.
model SystemError {
  id             String              @id @default(cuid())
  service        String
  errorType      String              @map("error_type")
  severity       SystemErrorSeverity
  message        String
  impact         String?
  recommendation String?
  count          Int                 @default(1)
  firstSeen      DateTime            @default(now()) @map("first_seen")
  lastSeen       DateTime            @default(now()) @map("last_seen")
  resolved       Boolean             @default(false)

  @@index([lastSeen])
  @@map("system_errors")
}

/// Email Reputation Protection Engine
/// Tracks sending limits and account health per email address.
/// Multi-User Connected Email Accounts & Reputation Protection Engine
/// Tracks OAuth tokens, sending limits, and connection health per connected mailbox.
model EmailAccount {
  email             String    @id
  daily_limit       Int       @default(300)
  hourly_limit      Int       @default(50)
  health_score      Int       @default(100)
  warmup_status     String    @default("COMPLETED")
  sent_today        Int       @default(0)
  sent_this_hour    Int       @default(0)
  access_token      String?
  connection_status String    @default("CONNECTED")
  created_at        DateTime  @default(now())
  refresh_token     String?
  token_expires_at  DateTime?
  updated_at        DateTime  @default(now()) @updatedAt
  user_id           String
  last_login_at     DateTime?
  last_seen_at      DateTime?
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, connection_status])
  @@index([user_id])
  @@index([user_id, updated_at])
  @@map("email_accounts")
}

/// Enterprise Audit System
/// Complete history of user and system actions for accountability.
model AuditLog {
  id              String           @id @default(cuid())
  action_type     AuditActionType?
  action          String
  user_id         String?
  prospect_id     String?
  sequence_id     String?
  metadata        Json?
  created_at      DateTime         @default(now())
  actor_email     String?
  actor_id        String?
  actor_name      String?
  actor_type      ActorType        @default(USER)
  category        AuditCategory    @default(SYSTEM)
  correlation_id  String?
  country         String?
  description     String?
  duration_ms     Int?
  error_message   String?
  ip_address      String?
  new_values      Json?
  old_values      Json?
  request_id      String?
  resource_id     String?
  session_id      String?
  severity        AuditSeverity    @default(INFO)
  status          AuditStatus      @default(SUCCESS)
  target_resource String?
  user_agent      String?

  @@index([created_at])
  @@index([action])
  @@index([actor_id, created_at])
  @@index([actor_id])
  @@index([category])
  @@index([correlation_id])
  @@index([target_resource, resource_id])
  @@map("audit_logs")
}

/// Persists the Gmail Watch registration, History API cursor, and Health State per mailbox.
///
/// One row per connected Gmail address (keyed by email).
/// Supports thousands of connected Gmail accounts independently.
model GmailWatchState {
  /// The Gmail address this watch is registered for (e.g. "user@example.com"). Primary key.
  email          String    @id
  /// Last Gmail historyId successfully processed — the engine's cursor.
  history_id     String
  /// Unix timestamp (ms) when this Gmail Watch registration expires (max 7 days).
  expiration     BigInt
  /// Full Google Cloud PubSub topic name used for this watch registration.
  topic_name     String
  registered_at  DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  /// Timestamp of last automatic self-healing recovery action
  auto_healed_at DateTime?
  /// Error counter for self-healing thresholds
  error_count    Int       @default(0)
  /// Operational Health Status: HEALTHY | SYNCING | EXPIRING_SOON | EXPIRED | NEEDS_RECONNECT
  health_status  String    @default("HEALTHY")
  /// Last operational error message (if any)
  last_error     String?
  /// Timestamp of last successful history delta sync
  last_synced_at DateTime?
  user_id        String?

  @@index([user_id])
  @@map("gmail_watch_state")
}

/// Global System Settings
model SystemSettings {
  id                         String   @id @default("global")
  scheduler_enabled          Boolean  @default(true)
  scheduler_cron             String   @default("*/15 * * * *")
  gemini_enabled             Boolean  @default(true)
  gemini_model               String   @default("gemini-1.5-pro-latest")
  notifications_global       Boolean  @default(true)
  notify_on_reply            Boolean  @default(true)
  notify_on_failure          Boolean  @default(true)
  retry_failed_emails        Boolean  @default(true)
  max_retries                Int      @default(3)
  updated_at                 DateTime @default(now()) @updatedAt
  auto_closer_auto_draft     Boolean  @default(true)
  auto_closer_enabled        Boolean  @default(true)
  auto_closer_rebuttal_style String   @default("AGGRESSIVE")
  monthly_ai_credit_limit    Int      @default(50000)
  smart_deliverability       Boolean  @default(true)

  @@map("system_settings")
}

/// Enterprise Universal Email Tracking Engine
/// A provider-agnostic representation of an outgoing email.
model TrackedEmail {
  id                  String          @id @default(cuid())
  provider            String
  sender_email        String
  recipient_email     String
  subject             String?
  source_type         String
  source_id           String?
  provider_message_id String?         @unique
  provider_thread_id  String?
  status              String          @default("QUEUED")
  open_count          Int             @default(0)
  click_count         Int             @default(0)
  first_opened_at     DateTime?
  last_opened_at      DateTime?
  replied_at          DateTime?
  bounced_at          DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  user_id             String?
  events              TrackingEvent[]

  @@index([provider_message_id])
  @@index([source_type, source_id])
  @@index([status])
  @@index([user_id, status, created_at])
  @@map("tracked_emails")
}

/// Immutable Event Log for Tracking
model TrackingEvent {
  id               String       @id @default(cuid())
  tracked_email_id String
  event_type       String
  occurred_at      DateTime     @default(now())
  ip_address       String?
  user_agent       String?
  metadata         Json?
  tracked_email    TrackedEmail @relation(fields: [tracked_email_id], references: [id], onDelete: Cascade)

  @@index([tracked_email_id, event_type])
  @@index([occurred_at])
  @@map("tracking_events")
}

/// 100% Honest AI Usage Tracking
model AiUsageLog {
  id          String   @id @default(cuid())
  email       String
  feature     String
  tokens_used Int
  occurred_at DateTime @default(now())
  metadata    Json?

  @@index([email, occurred_at])
  @@map("ai_usage_logs")
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model announcements {
  id          String    @id
  title       String
  message     String
  type        String
  link        String?
  buttonText  String?
  scheduledAt DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([scheduledAt, isActive])
}

model config_versions {
  id                String   @id
  version           Int      @unique @default(autoincrement())
  actor             String
  timestamp         DateTime @default(now())
  reason            String
  target_id         String?
  affected_settings Json
  snapshot          Json
}

model feature_flags {
  id               String          @id @default(cuid())
  key              String          @unique
  name             String
  description      String?
  category         ConfigCategory
  enabled          Boolean         @default(true)
  risk_level       RiskLevel       @default(SAFE)
  is_safe_runtime  Boolean         @default(true)
  requires_reason  Boolean         @default(false)
  rollout_strategy RolloutStrategy @default(GLOBAL)
  rollout_percent  Int?
  rollout_rules    Json?
  depends_on       String[]
  environment      String          @default("production")
  updated_by       String?
  updated_at       DateTime        @updatedAt
  created_at       DateTime        @default(now())
  history          flag_history[]

  @@index([key])
  @@index([category])
  @@index([environment])
}

model oauth_states {
  id         String   @id
  token      String   @unique
  user_id    String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([expires_at])
  @@index([token])
  @@index([user_id])
}

model platform_configs {
  id               String         @id @default(cuid())
  key              String         @unique
  name             String
  description      String?
  category         ConfigCategory
  data_type        DataType
  value            Json
  default_value    Json
  validation_rules Json?
  is_safe_runtime  Boolean        @default(true)
  requires_reason  Boolean        @default(false)
  risk_level       RiskLevel      @default(SAFE)
  environment      String         @default("production")
  updated_by       String?
  updated_at       DateTime       @updatedAt
  created_at       DateTime       @default(now())
  history          config_history[]

  @@index([key])
  @@index([category])
  @@index([environment])
}

model provider_configs {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String?
  active_provider  String
  allowed_values   String[]
  environment      String            @default("production")
  updated_by       String?
  updated_at       DateTime          @updatedAt
  created_at       DateTime          @default(now())
  history          provider_history[]

  @@index([key])
  @@index([environment])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model users {
  id             String         @id
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  role           String         @default("USER")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  adminNotes     String?
  isSuspended    Boolean        @default(false)
  accounts       accounts[]
  campaigns      Campaign[]
  email_accounts EmailAccount[]
  prospects      Prospect[]
  sequences      Sequence[]
  sessions       sessions[]
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model waitlist {
  id          String         @id
  email       String         @unique
  status      WaitlistStatus @default(PENDING)
  position    Int            @unique
  created_at  DateTime       @default(now())
  approved_at DateTime?
  pre_added   Boolean        @default(false)

  @@index([position])
  @@index([status])
}

/// Manual one-off emails sent outside of automated sequences.
model AdhocEmail {
  id               String           @id @default(cuid())
  prospect_id      String
  subject          String
  body             String
  sent_at          DateTime?
  gmail_message_id String?
  gmail_thread_id  String?
  error_message    String?
  scheduled_at     DateTime?
  status           AdhocEmailStatus @default(SENT)
  prospect         Prospect         @relation(fields: [prospect_id], references: [id], onDelete: Cascade)

  @@index([prospect_id, sent_at])
  @@map("adhoc_emails")
}

enum ProspectSource {
  MANUAL
  SMART_IMPORT
  API
}

enum ProspectStatus {
  ACTIVE
  REPLIED
  STOPPED
  COMPLETED
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  STOPPED
  COMPLETED
  PAUSED
  FAILED
  CANCELLED
  ARCHIVED
}

enum StepStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
  CANCELLED
  DELAYED
}

enum EmailEventType {
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

enum ReplyType {
  REAL_REPLY
  AUTO_REPLY
  SPAM
  UNSUBSCRIBE
  NOT_INTERESTED
  INTERESTED
  NEEDS_REVIEW
}

enum ReviewStatus {
  PENDING
  CONFIRMED_STOP
  CONFIRMED_KEEP_ACTIVE
  DISMISSED
}

enum SystemErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditActionType {
  USER_ACTION
  SYSTEM_ACTION
}

enum ActorType {
  USER
  SYSTEM
  ADMIN
}

enum AuditCategory {
  AUTHENTICATION
  USER_MANAGEMENT
  BILLING
  CAMPAIGN
  PROSPECT
  SEQUENCE
  EMAIL
  GMAIL_INTEGRATION
  AI_PROCESSING
  SCHEDULER
  SYSTEM
  ADMIN
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum ConfigCategory {
  AI
  SCHEDULER
  OUTREACH
  INTEGRATION
  DATA
  INFRASTRUCTURE
  SECURITY
}

enum DataType {
  NUMBER
  STRING
  JSON
  BOOLEAN
  ENUM
}

enum FeatureStatus {
  ENABLED
  DISABLED
  MAINTENANCE
}

enum RiskLevel {
  SAFE
  WARNING
  RESTRICTED
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdhocEmailStatus {
  PENDING
  SENT
  FAILED
}


// ─────────────────────────────────────────────────────────────────────────────
// Phase 17 — Enterprise History Models & Supporting Enums
// ─────────────────────────────────────────────────────────────────────────────

enum RolloutStrategy {
  GLOBAL
  PERCENTAGE
  USER_LIST
  ROLE
  PLAN
  COUNTRY
}

/// Immutable change history for Feature Flags
model flag_history {
  id          String        @id @default(cuid())
  flag        feature_flags @relation(fields: [flag_id], references: [id], onDelete: Cascade)
  flag_id     String
  old_value   Json
  new_value   Json
  reason      String?
  is_rollback Boolean       @default(false)
  changed_by  String
  changed_at  DateTime      @default(now())

  @@index([flag_id, changed_at])
}

/// Immutable change history for Platform Configuration
model config_history {
  id         String          @id @default(cuid())
  config     platform_configs @relation(fields: [config_id], references: [id], onDelete: Cascade)
  config_id  String
  old_value  Json
  new_value  Json
  reason     String?
  is_rollback Boolean        @default(false)
  changed_by String
  changed_at DateTime        @default(now())

  @@index([config_id, changed_at])
}

/// Immutable change history for Provider Configuration
model provider_history {
  id          String          @id @default(cuid())
  provider    provider_configs @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  provider_id String
  old_value   Json
  new_value   Json
  reason      String?
  is_rollback Boolean         @default(false)
  changed_by  String
  changed_at  DateTime        @default(now())

  @@index([provider_id, changed_at])
}

