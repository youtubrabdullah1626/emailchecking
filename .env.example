# ==============================================================
# Outreach Automation System — Environment Variables
# ==============================================================
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# The .gitignore already excludes it.
#
# Variable naming rules:
#   - Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
#     Only use NEXT_PUBLIC_ for values that are safe to be public.
#   - DATABASE_URL and DIRECT_URL must NEVER be prefixed NEXT_PUBLIC_.
#     They are server-only and must never reach the browser.

# --------------------------------------------------------------
# Supabase PostgreSQL — via Prisma ORM
# --------------------------------------------------------------
# Use the pooled connection string (port 6543) for runtime queries.
# Prisma requires ?pgbouncer=true on the pooled URL.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Use the direct connection string (port 5432) for Prisma migrations.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --------------------------------------------------------------
# Supabase JS Client — browser-safe credentials
# Added here for future realtime/auth phases. Not required in Phase 1.
# --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# --------------------------------------------------------------
# Gmail OAuth 2.0 — server-side only (Phase 5)
# These must NEVER be prefixed NEXT_PUBLIC_
# --------------------------------------------------------------
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=

# --------------------------------------------------------------
# Gemini API — server-side only (Phase 6, optional)
# --------------------------------------------------------------
# GEMINI_API_KEY=

# --------------------------------------------------------------
# Production API Security — Phase 11
#
# SCHEDULER_SECRET protects all operational API endpoints:
#   POST /api/scheduler/run
#   POST /api/scheduler/drain  (dev only)
#   POST /api/gmail/send
#   POST /api/gmail/send-now
#   POST /api/replies/scan
#
# Generate a strong secret:
#   openssl rand -hex 32
#
# Usage with curl:
#   curl -X POST http://localhost:3000/api/scheduler/run \
#     -H "Authorization: Bearer <your-secret>"
#
# In development: if this is not set, requests are allowed through
# with a warning log (developer convenience). In production, requests
# are rejected with 401 if this is not set.
# --------------------------------------------------------------
# SCHEDULER_SECRET=

# --------------------------------------------------------------
# Vercel Cron Secret — Phase 11 (set automatically by Vercel)
#
# Vercel automatically injects CRON_SECRET into the runtime environment
# when deploying to Vercel. You do NOT need to set this manually.
#
# For external cron services (cron-job.org, GitHub Actions, etc.):
# use SCHEDULER_SECRET as the Authorization: Bearer token instead.
#
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
# --------------------------------------------------------------
# CRON_SECRET=
